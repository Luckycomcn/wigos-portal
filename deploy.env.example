# Map + catalogue configuration, read by the container at start-up.
# Copy to deploy.env and fill in real values (deploy.env is git-ignored).

# 天地图 key（浏览器端直连 t0-t7.tianditu.gov.cn）
TIANDITU_KEY=

# 高德 key + 安全密钥（浏览器端直连高德瓦片）
AMAP_KEY=
AMAP_SECURITY_JS_CODE=

# 可选：高德走 nginx 反向代理时填写，例如 /_AMapService
# （填了它就会优先用代理，AMAP_SECURITY_JS_CODE 由 nginx 注入）
AMAP_SERVICE_HOST=

# 可选：WIGOS 元数据目录服务地址，默认 WMO 测试环境
WIGOS_GOFC_URL=https://wmo-resource-catalogue.labs.wis2dev.io
